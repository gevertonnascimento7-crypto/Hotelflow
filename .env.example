# Copie para .env.local (desenvolvimento) ou configure no painel da Vercel.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Opcional, mas recomendado: habilita notificações push com o app fechado.
# Nunca exponha esta chave no navegador. Use apenas no servidor (Vercel).
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: conexão direta com o Postgres para aplicar o banco automaticamente
# durante o build (a integração Supabase da Vercel já define POSTGRES_URL_NON_POOLING).
# DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
